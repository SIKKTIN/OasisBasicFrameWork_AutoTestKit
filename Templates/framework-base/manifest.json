      ],
      "loadModule": "Script.Core.DebugKit.Global_DebugKit",
      "exportedGlobal": "Global_DebugKit",
      "notes": "随包提供 Lifecycle、PlayerLifecycle 通用检测线及空预测配置；目标项目生成具体预测后可用于节点比对。"
