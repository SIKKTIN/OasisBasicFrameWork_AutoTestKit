        "UGCGameSystem.IsServer",
        "ugcprint"
      ],
      "loadModule": "Script.Core.ClientCache.Global_ClientCache",
      "exportedGlobal": "Global_ClientCache",
      "notes": "Global_ClientCache 未显式 return，通过全局表提供 API；保留源项目已有 Type.EVACUATE_SETTLE 标签，当前未做通用化改写。"
    },
    {
      "name": "EventSystem",
      "path": "Script/Core/EventSystem",
