    {
      "name": "TipSystem",
      "path": "Script/Core/TipSystem",
      "projectDependencies": [],
      "bundledDependencies": [
        "Script/Const/Core/Const_Tip.lua"
      ],
      "engineDependencies": [
        "UGCWidgetManagerSystem.ShowTipsUI",
        "ugcprint"
      ],
      "loadModule": "Script.Core.TipSystem.Global_Tip",
      "exportedGlobal": "Global_Tip",
      "integrationRequirements": [
        "客户端通过 GameState 的 LifeCycle.Tick 持续驱动 Global_Tip.Tick，禁止重复驱动。",
        "owner 仅用于队列分组和有效性检查，服务端向客户端发送提示需由调用方提供 RPC。"
      ],
      "knownLimitations": [
        "延迟按帧数计算，Tick 忽略 DeltaTime；FIRST_DELAY_FRAMES=30，DEFAULT_DELAY_FRAMES=90。",
        "Clear(nil) 不清空全局队列。"
      ],
      "notes": "两个实现脚本及优先级常量均原样复制；无需 UISystem、数据表或自定义资产。服务端通知 RPC 可由可选 GM 适配提供。"
    },
    {
      "name": "CommandSystem",
      "path": "Script/Core/CommandSystem",
      "projectDependencies": [],
      "bundledDependencies": [
        "Script/Setting/CommandConfigIndex.lua"
      ],
      "engineDependencies": [
        "UGCGameSystem.IsServer",
        "UGCGameSystem.GetLocalPlayerController",
        "UGCGameSystem.GetPlayerKeyByPlayerController",
        "UnrealNetwork.CallUnrealRPC",
        "ugcprint"
      ],
      "loadModule": "Script.Core.CommandSystem.Global_CommandSystem",
      "exportedGlobal": "Global_CommandSystem",
      "integrationRequirements": [
        "空索引允许零指令初始化；目标项目在 Script/Config/Command 添加声明后，由 GenKit 生成 CommandConfigIndex.lua。",
        "跨端执行及结果回传由可选 GM 的控制器适配提供；未安装 GM 时仍须完成框架接入，本地执行不依赖 GM。"
      ],
      "notes": "核心脚本收录，Global.BeginPlay 修复为透传 Initialize 结果，新建空 CommandConfigIndex 作为初始种子，不收录来源项目业务指令。保留 Enabled=true 和 CanExecute 默认放行配置；已有目标索引按文件冲突规则保留。",
      "startupValidation": {
        "test": "GenKit/Tests/Test_LifecycleRegistries.lua",
        "runtimeVerified": false,
        "testBase": "toolRoot"
      }
    },
    {
      "name": "AutoTestKit",
      "path": "Script/Core/AutoTestKit",
      "projectDependencies": [],
      "bundledDependencies": [
        "Script/Setting/AutoTestSuiteIndex.lua"
      ],
      "engineDependencies": [
        "ugcprint"
      ],
      "optionalEngineDependencies": [
        "UnrealNetwork.CallUnrealRPC"
      ],
      "loadModule": "Script.Core.AutoTestKit.Global_AutoTestKit",
      "exportedGlobal": "Global_AutoTestKit",
      "integrationRequirements": [
        "执行测试的入口持续调用 Global_AutoTestKit.Tick(DeltaTime)；不自动运行套件。",
        "传入 PlayerController 时使用 Client_TipContent 通知，由可选 GM 适配提供；未接该通道时传 nil，仅记录日志和报告。",
        "目标项目在 Script/Config/AutoTestSuite 添加套件后由 GenKit 生成索引；空索引初始化成功，RunAll 返回 false 且报告 no-tests。"
      ],
      "notes": "五个核心脚本与新建空索引随包部署，不迁入来源业务 Suite。模板修复初始化错误反馈、断言结果锁定、生命周期错误记录及单 Case/Stop 清理；GetReport 提供最终状态，生命周期错误独立于 Case 数量。",
      "validation": {
        "test": "Tests/Test_AutoTestKit.lua",
        "type": "isolated-lua",
        "checksPassed": 24,
        "engineNotifications": "mocked",
        "runtimeVerified": false
      }
    },
    {
      "name": "GameDataCore",
      "path": "Script/Core/GameDataCore",
      "projectDependencies": [],
      "bundledDependencies": [
        "Script/Setting/Package_Meta_Index.lua",
        "Script/Event/Event_DataChange.lua",
        "Script/Core/EventSystem/UGCEventSystem.lua"
      ],
      "engineDependencies": [
        "UGCGameSystem.GetGameState",
        "UGCGameSystem.IsServer",
        "ugcprint"
      ],
      "loadModule": "Script.Core.GameDataCore.Global_GameDataCore",
      "exportedGlobal": "Global_GameDataCore",
      "integrationRequirements": [
        "先加载事件总线；初始化必须生成实际 Core 清单并同步 GameState 入口，由 LifeCycle 启动。",
        "空 Meta 索引允许零 gameData 初始化；新增 gameData 后由目标项目 GenKit 生成 Meta、数据常量和分类变更事件，并接入 GameState 字段复制。"
      ],
      "notes": "Global 原样复制；System 修复 DataInit false、Meta 错误反馈及失败后显式重试。重试重建声明，失败模块内部 DataInit 须幂等；其他已审查问题留待处理。",
      "validation": {
        "test": "Tests/Test_GameDataCore.lua",
        "type": "isolated-lua",
        "checksPassed": 8,
        "gameState": "mocked",
        "runtimeVerified": false
      },
      "startupValidation": {
        "test": "GenKit/Tests/Test_LifecycleRegistries.lua",
        "runtimeVerified": false,
        "testBase": "toolRoot"
      }
    },
    {
      "name": "PlayerDataCore",
      "path": "Script/Core/PlayerDataCore",
      "projectDependencies": [],
      "bundledDependencies": [
        "Script/Setting/Package_Meta_Index.lua",
        "Script/Const/Data/Const_Data.lua",
        "Script/Event/EventType.lua",
        "Script/Event/Event_DataChange.lua",
        "Script/Core/EventSystem/UGCEventSystem.lua"
      ],
      "engineDependencies": [
        "UGCGameSystem.IsServer",
        "UGCGameSystem.GetUIDByPlayerController",
        "UGCGameSystem.GetPlayerKeyByPlayerController",
        "UGCPlayerStateSystem.GetPlayerArchiveData",
        "UGCPlayerStateSystem.SavePlayerArchiveData",
        "ugcprint"
      ],
      "loadModule": "Script.Core.PlayerDataCore.Global_PlayerDataCore",
      "exportedGlobal": "Global_PlayerDataCore",
      "integrationRequirements": [
        "先加载 EventType 和事件总线；初始化必须生成实际 Core 清单并同步实际入口，由 LifeCycle 启动。",
        "通用 PropertyComponent 不依赖 Registry_ConditionData；CheckArchiveData 返回 true=已有、false=无存档、nil=错误，仅 false 分支调用 InitAllData(playerKey)，汇总成功才首次保存。不要同时发送旧初始化事件再直接初始化。 初始化及首次保存或恢复成功后，由组件调用 LifeCycle.NotifyPlayerDataLoaded(pc)。",
        "空 table 或 nil 且 GetPlayerDataSize(uid)==0 确认为无存档；其他 nil、读取异常、非空无标记存档或不支持版本均为错误。PIE 已确认空存档 nil/零字节，跨对局持久化仍待验收。",
        "按目标声明生成数据常量、Meta 及分类变更事件，实际 PlayerController 入口按生成常量接入数据复制；未声明玩家数据包时跳过保存。"
      ],
      "archiveFormat": {
        "metadataKey": "__oasisArchive",
        "version": 1,
        "businessLayout": "flat",
        "legacyMigration": "explicit-only"
      },
      "knownLimitations": [
        "不迁入业务 PropertyComponent；来源组件的 if not CheckArchiveData 和 ConditionData.IsInitialized 不适用于本模板新协议。",
        "无标记旧存档需要独立迁移；不自动覆盖。恢复缺失包保持来源空表回退，不新增逐包初始化或迁移机制。",
        "DataFormat false 返回、嵌套查询边界、多数据键反查尚未修复；Meta 错误反馈、失败后显式重试及事件异常隔离已处理。"
      ],
      "notes": "Global 原样复制；System 使用独立框架存档标记，修复 DataInit 失败结果、读写异常反馈及恢复前的数据包类型检查。标记不登记到 Const_Data 或复制字段。其他审查问题未在本次扩展修复。 本次补齐 Meta 错误反馈与失败后显式重试，未加载 EventType 时返回失败而非直接抛异常。",
      "validation": {
        "test": "Tests/Test_PlayerDataCore.lua",
        "type": "isolated-lua",
        "checksPassed": 20,
        "engineArchive": "mocked",
        "runtimeVerified": false
      },
      "startupValidation": {
        "test": "GenKit/Tests/Test_LifecycleRegistries.lua",
        "runtimeVerified": false,
        "testBase": "toolRoot"
      },
      "optionalEngineDependencies": [
        "UGCPlayerStateSystem.GetPlayerDataSize"
      ]
    },
    {
      "name": "LifeCycle",
      "path": "Script/Core/LifeCycle",
      "projectDependencies": [],
      "bundledDependencies": [
        "Script/Event/EventType.lua",
        "Script/Core/EventSystem/UGCEventSystem.lua",
        "Script/Core/DebugKit/Global_DebugKit.lua",
        "Script/Setting/Core_Registry.lua",
        "Script/Setting/Package_Registry.lua"
      ],
      "engineDependencies": [
        "UGCGameSystem.IsServer",
        "UGCGameSystem.GetPlayerKeyByPlayerController",
        "UGCGameSystem.GetLocalPlayerController",
        "UGCGameSystem.GetPlayerControllerByPlayerPawn",
        "UGCGameSystem.GetPlayerPawnByPlayerController",
        "ugcprint"
      ],
      "optionalEngineDependencies": [
        "UGCObjectUtility.IsObjectValid"
      ],
      "loadModule": "Script.Core.LifeCycle.Life_Cycle",
      "exportedGlobal": "LifeCycle",
      "initializationMode": "explicit-bootstrap",
      "integrationRequirements": [
        "显式加载，不加入 Core_Registry；BeginPlay 注册监听，OnGameStateInit 汇总启动结果，Tick 驱动条件等待、Core.Tick 与 Package.GameStateTick，旧入口不可重复 Tick。",
        "空注册表仅为种子；初始化必须生成目标清单并完成 GameState、PC/Pawn 创建/退出接线，PropertyComponent 按 JSON 通过 MCP 创建并挂载。",
        "业务 GameMode 可在包 BeginPlay 订阅两端 Lifecycle_FrameworkReady 后自行 LoadCurrentMode；GM 已作为独立可选模板订阅本地 PC 事件，LifeCycle 无二者依赖。",
        "数据加载方成功后调用 NotifyPlayerDataLoaded，不能依靠旧固定延时或仅发旧广播；服务端 Pawn 等实际数据就绪，客户端只处理本地 PC/Pawn。"
      ],
      "knownLimitations": [
        "真实 PIE、对象有效性与跨对局存档语义未验证。",
        "同一 Lua 世界只支持同一 GameState；不提供任意模块副作用回滚或同 VM 跨 GameState 卸载重启。",
        "FrameworkReady 不等于地图或业务加载完成；监听返回 false 不作为业务结果汇总，失败包需自行记录结果/重试。"
      ],
      "validation": {
        "test": "Tests/Test_LifeCycle.lua",
        "type": "isolated-lua",
        "checksPassed": 31,
        "engine": "mocked",
        "runtimeVerified": false
      }
    }
  ],
