      "exportedGlobal": "UGCEventSystem",
      "notes": "同步通知总线；同事件/函数/对象去重，按快照隔离监听异常。返回广播执行状态，不汇总监听函数业务返回值；显式 return 全局表。",
      "startupValidation": {
        "test": "Tests/Test_LifeCycle.lua",
        "runtimeVerified": false
      }
    },
    {
      "name": "DebugKit",
